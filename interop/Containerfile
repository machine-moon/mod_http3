ARG MODULE_IMAGE
FROM ${MODULE_IMAGE} AS module

FROM martenseemann/quic-network-simulator-endpoint:latest AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcre2-8-0 libxml2 libexpat1 zlib1g liblua5.4-0 libbrotli1 libnghttp2-14 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=module /src/dependencies/ /src/dependencies/
COPY --from=module /src/quic/third-party/ /src/quic/third-party/

RUN ldd /src/dependencies/httpd-dist/bin/httpd | grep -q "not found" && exit 1; \
    ldd /src/dependencies/httpd-dist/modules/mod_http3.so | grep -q "not found" && exit 1; true

COPY interop/httpd.conf      /src/dependencies/httpd-dist/conf/httpd.conf
COPY interop/run_endpoint.sh /run_endpoint.sh
RUN chmod +x /run_endpoint.sh

ENTRYPOINT [ "/run_endpoint.sh" ]
